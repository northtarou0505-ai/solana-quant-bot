# ==========================================
# Solana クオンツ自動売買ボット 設定テンプレート
# ==========================================

# 動作モード: PAPER (実資金を使わない仮想売買・初期推奨) または LIVE (Phantomサブウォレット実資金取引)
TRADING_MODE=PAPER

# 1,000円スタート用の初期予算設定（PAPERモードの初期USDC残高: 6.80 USDC ≈ 約1,000円）
INITIAL_BUDGET_JPY=1000
INITIAL_PAPER_USDC=6.80

# --- LIVEモード用: Solana / Phantom サブウォレット設定 ---
# ※メインウォレットの秘密鍵は絶対に入力しないでください！
# ※Phantom内で「自動売買専用サブアカウント（1,000円〜少額のみ入金）」を作成し、その秘密鍵を設定してください。
SOLANA_PRIVATE_KEY=your_private_key_here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ガス代枯渇防止のためにウォレットに常時残す最小SOL残高（0.012 SOL ≈ 約250〜300円）
MIN_SOL_GAS_RESERVE=0.012

# スリッページ許容幅（50 = 0.5%）とPriority Fee上限（50000 lamports = 0.00005 SOL）
SLIPPAGE_BPS=50
MAX_PRIORITY_FEE_LAMPORTS=50000

# --- リスク管理・サーキットブレーカー設定 ---
# 1トレードあたりの最大損切り幅(%) と 最小利確目標幅(%)
MAX_STOP_LOSS_PCT=2.2
MIN_TAKE_PROFIT_PCT=3.8
# 1日の最大許容ドローダウン(%) -> これを超えると当日自動停止
MAX_DAILY_DRAWDOWN_PCT=5.0
# 連敗クールダウン発動回数
MAX_CONSECUTIVE_LOSSES=3

# --- オプション: AI監視・Telegram通知設定 ---
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H=10000
